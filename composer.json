{
    "name": "andersoncav/yugioh-card-explorer",
    "description": "Yu-Gi-Oh! Card Explorer em arquitetura MVC com Service Layer",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "bramus/router": "^1.6",
        "guzzlehttp/guzzle": "^7.9",
        "monolog/monolog": "^3.10",
        "php-di/php-di": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    }
}
